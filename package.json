{
  "name": "energy-monitoring",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "start": "concurrently \"npm --prefix backend start\" \"npm --prefix frontend start\"",
    "seed": "npm --prefix backend run seed",
    "start:backend": "npm --prefix backend start",
    "start:frontend": "npm --prefix frontend start",
    "build": "npm --prefix frontend run build"
  },
  "dependencies": {
    "mongodb": "^7.3.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
